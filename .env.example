# Azure Document Intelligence (required)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-api-key>

# Streamable HTTP MCP
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Generate a strong token, e.g. openssl rand -hex 32
MCP_AUTH_TOKEN=<your-shared-bearer-token>

# S3 storage for result files and uploaded source documents
S3_BUCKET=<your-private-result-bucket>
S3_REGION=us-east-1
S3_PREFIX=document-intelligence/results
# Separate, non-overlapping source-document prefix; configure lifecycle on both prefixes.
S3_UPLOAD_PREFIX=document-intelligence/uploads
# Optional: custom S3-compatible endpoint (also used in upload/download links).
# Must be reachable by the server, upload/download clients, AND Azure over HTTPS for fileId analysis.
# S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=false
# Optional: omit all three to use the AWS credential provider chain (IAM role, etc.).
# S3_ACCESS_KEY_ID=<your-access-key>
# S3_SECRET_ACCESS_KEY=<your-secret-key>
# S3_SESSION_TOKEN=<optional-temporary-session-token>

# Logical lifetime for results AND uploaded source files; configure lifecycle for both prefixes.
# Positive whole days. Source retention starts on successful upload; result retention on creation.
# Analyzing/downloading does not extend either lifetime.
FEATURE_RESULT_RETENTION_DAYS=7
# Positive hours (fractions allowed), at least 1 second, at most 168 hours (AWS SigV4 limit).
# Applies to upload PUT links, result downloads, and internal source GET links for Azure.
# GET links are capped by the object's remaining retention. Temporary credentials may expire sooner.
FEATURE_PRESIGNED_RETENTION_HOURS=1
